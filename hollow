#!/bin/bash
# HollowEngine CLI launcher (Godot-style). Usage: ./hollow <command> [args]
export JAVA_HOME="${JAVA_HOME:-/home/z/my-project/tools/jdk-21.0.13+9}"
DIR="$(cd "$(dirname "$0")" && pwd)"
CP="$DIR/cli/build/libs/cli.jar:$DIR/engine/build/libs/engine.jar"
if [ ! -f "$DIR/engine/build/libs/engine.jar" ]; then
  # fall back to Gradle-built classes
  CP="$DIR/cli/build/classes/java/main:$DIR/engine/build/classes/java/main"
fi
exec "$JAVA_HOME/bin/java" -cp "$CP" com.hollow.cli.Main "$@"
